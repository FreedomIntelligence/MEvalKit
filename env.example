# MEvalKit 环境变量配置
# 复制此文件为 .env 并修改相应的值

# Flask 配置
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=false

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=1984

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 其他模型API配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# 数据库配置（如果需要）
DATABASE_URL=sqlite:///mevalkit.db

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# 缓存配置
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 安全配置
SECRET_KEY=your_secret_key_here_change_this_in_production
WTF_CSRF_ENABLED=true

# 评估配置
DEFAULT_WORKERS=64
DEFAULT_QUESTION_LIMITATION=100
MAX_WORKERS=128

# 文件上传配置
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=/app/data/uploads

# 模型配置
DEFAULT_MODEL_NAME=doubao-1.5-pro-32k
DEFAULT_API_BASE=
DEFAULT_MODEL_KEY=

# 数据集配置
DATASET_CACHE_DIR=/app/data/datasets
MODEL_CACHE_DIR=/app/data/models

# 性能配置
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Swagger配置
SWAGGER_HOST=localhost:5000 